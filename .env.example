# Clave de la API de Anthropic (sin ella la oficina corre en MODO DEMO con datos simulados)
ANTHROPIC_API_KEY=

# Modelo para cada nivel jerárquico
MODEL_ANALYST=claude-opus-5-5
MODEL_MANAGER=claude-opus-5-5
MODEL_DIRECTOR=claude-opus-5-5

# Esfuerzo de razonamiento: low | medium | high | xhigh | max
EFFORT_ANALYST=high
EFFORT_MANAGER=high
EFFORT_DIRECTOR=xhigh

# Máximo de búsquedas web por analista
MAX_SEARCHES_PER_ANALYST=8

# Cuántos analistas trabajan en simultáneo (ajustar según tu rate limit)
CONCURRENCY=4

PORT=3000
